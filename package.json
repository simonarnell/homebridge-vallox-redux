{
  "name": "homebridge-vallox-redux",
  "displayName": "Vallox Redux",
  "version": "0.1.0",
  "description": "Homebridge plugin for Vallox MVHR ventilation units (via vallox.js)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0 || >=24",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "pretest:integration": "npm run build",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --config jest.integration.config.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "vallox",
    "mvhr",
    "ventilation",
    "hrv"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonarnell/homebridge-vallox-redux.git"
  },
  "author": "Simon Arnell",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "fakegato-history": "^0.6.7",
    "vallox.js": "^1.7.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "hap-controller": "^0.10.2",
    "homebridge": "^2.4.0",
    "jest": "^30.3.0",
    "rimraf": "^6.0.0",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2"
  }
}
